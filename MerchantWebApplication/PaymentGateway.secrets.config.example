<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to PaymentGateway.secrets.config in the same folder and fill in the values.
  PaymentGateway.secrets.config is listed in .gitignore, so it never gets committed.
-->
<appSettings>
  <add key="PaymentGateway.UserName" value="your-merchant-user" />
  <add key="PaymentGateway.Password" value="your-merchant-password" />
  <!-- SendPlainText or SendHashed, whichever your payment gateway environment expects. -->
  <add key="PaymentGateway.PasswordOption" value="SendPlainText" />
  <add key="PaymentGateway.CreditCardUrl" value="https://paygateway.example.com/PS/CreditCardPmtMng" />
  <add key="PaymentGateway.SadadUrl" value="https://paygateway.example.com/PS/SADADPmtMng" />
  <add key="PaymentGateway.PayPalUrl" value="https://paygateway.example.com/PS/PayPalPmtMng" />
</appSettings>
