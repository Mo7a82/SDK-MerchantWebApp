<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="SDKClassLibrary.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <applicationSettings>
        <SDKClassLibrary.Properties.Settings>
            <setting name="SDKClassLibrary_CreditCardPmtMngRef_CreditCardPmtMng"
                serializeAs="String">
                <value>https://paygateway.example.com/PS/CreditCardPmtMng</value>
            </setting>
            <setting name="SDKClassLibrary_SADADPmtMngRef_SADADPmtMng" serializeAs="String">
                <value>https://paygateway.example.com/PS/SADADPmtMng</value>
            </setting>
            <setting name="SDKClassLibrary_PayPalPmtMngRef_PayPalPmtMng"
                serializeAs="String">
                <value>https://paygateway.example.com/PS/PayPalPmtMng</value>
            </setting>
        </SDKClassLibrary.Properties.Settings>
    </applicationSettings>
  <!--
    Payment gateway connection settings. Keep real values out of source control:
    put them in PaymentGateway.secrets.config next to the host application's config file
    (see MerchantWebApplication/PaymentGateway.secrets.config.example). Values in that file override the ones below.
  -->
  <appSettings file="PaymentGateway.secrets.config">
    <add key="PaymentGateway.UserName" value="" />
    <add key="PaymentGateway.Password" value="" />
    <!-- SendPlainText (default) or SendHashed. Use plain text only over HTTPS. -->
    <add key="PaymentGateway.PasswordOption" value="SendPlainText" />
    <!-- Leave empty to use the URLs from Properties/Settings.settings. -->
    <add key="PaymentGateway.CreditCardUrl" value="" />
    <add key="PaymentGateway.SadadUrl" value="" />
    <add key="PaymentGateway.PayPalUrl" value="" />
  </appSettings>
</configuration>